{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adp-protocol.org/schemas/dataset/1.0",
  "title": "ADP Dataset",
  "description": "Curated collection aggregating clips, annotations, and dictionary entries",
  "type": "object",
  "required": ["id", "name", "version", "license", "clips", "annotations", "dictionary_entries", "schema_version", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique dataset identifier"
    },
    "name": {
      "type": "string",
      "description": "Human-readable dataset name"
    },
    "description": {
      "type": "string",
      "description": "Dataset description"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
      "description": "Dataset version (semantic versioning)"
    },
    "license": {
      "type": "string",
      "default": "CC0-1.0",
      "description": "Dataset license (default: CC0-1.0)"
    },
    "clips": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "uri"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Clip identifier"
          },
          "uri": {
            "type": "string",
            "anyOf": [
              {"format": "uri", "pattern": "^https?://"},
              {"type": "string"}
            ],
            "description": "File path or HTTP/HTTPS URL"
          },
          "format": {
            "type": "string",
            "description": "Audio format (e.g., wav, mp3)"
          },
          "duration_sec": {
            "type": "number",
            "minimum": 0.0,
            "description": "Duration in seconds"
          },
          "checksum": {
            "type": "string",
            "description": "Content integrity hash"
          }
        },
        "additionalProperties": false
      },
      "description": "Audio clip references"
    },
    "annotations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "file_path"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Annotation identifier"
          },
          "file_path": {
            "type": "string",
            "description": "Path to annotation JSON file"
          }
        },
        "additionalProperties": false
      },
      "description": "Annotation references"
    },
    "dictionary_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file_path"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Dictionary entry identifier"
          },
          "file_path": {
            "type": "string",
            "description": "Path to dictionary entry JSON file"
          }
        },
        "additionalProperties": false
      },
      "description": "Dictionary entry references"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
      "description": "Semantic version"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "metadata": {
      "type": "object",
      "description": "Additional dataset metadata"
    }
  },
  "additionalProperties": false
}