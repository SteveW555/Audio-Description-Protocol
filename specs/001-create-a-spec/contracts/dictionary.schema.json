{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adp-protocol.org/schemas/dictionary/1.0",
  "title": "ADP Dictionary Entry",
  "description": "Standardized musical descriptor with hierarchical relationships",
  "type": "object",
  "required": ["id", "label", "definition", "schema_version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase kebab-case unique identifier"
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[- ][a-z0-9]+)*$",
      "description": "Human-readable lowercase label"
    },
    "definition": {
      "type": "string",
      "minLength": 10,
      "description": "Detailed description (minimum 10 characters)"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
      "description": "Semantic version"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[- ][a-z0-9]+)*$"
      },
      "description": "Alternative labels"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categorization tags"
    },
    "parent_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Reference to parent dictionary entry ID"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    }
  },
  "additionalProperties": false
}