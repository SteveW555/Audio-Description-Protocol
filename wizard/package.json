{
  "name": "adp-wizard-validation",
  "version": "1.0.0",
  "description": "ADP Wizard TypeScript Client for Python Validation Integration",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "serve dist --single --listen tcp://0.0.0.0:${PORT:-8080}",
    "generate-client": "openapi-generator-cli generate -i ../specs/003-integrate-wizard-interface/contracts/validation-api.yaml -g typescript-axios -o src/services/generated",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.7.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.0",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.2.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "@types/lodash": "^4.17.20",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "axios": "^1.5.0",
    "dotenv": "^17.2.3",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serve": "^14.2.5",
    "uuid": "^13.0.0",
    "zustand": "^5.0.8"
  }
}
