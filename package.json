{
  "name": "adp-wizard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd wizard && npm run dev",
    "build": "npm run build:wizard && npm run build:backend",
    "build:wizard": "cd wizard && npm run build",
    "build:backend": "cd backend && npm ci && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && cross-env PORT=3001 node dist/index.js",
    "start:frontend": "cross-env BACKEND_PORT=3001 node server.js",
    "preview": "cd wizard && npm run preview",
    "lint": "cd wizard && npm run lint",
    "type-check": "cd wizard && npm run type-check",
    "postinstall": "npm ci --prefix wizard && npm ci --prefix backend"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "express": "^4.18.2",
    "groq": "^4.10.2",
    "http-proxy-middleware": "^3.0.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
